enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN
  GESTIONNAIRE
  CAISSIER
  MEMBRE

  @@map("role_utilisateur")
}

enum SexeEnum {
  M
  F

  @@map("sexe_enum")
}

enum StatutMembre {
  ACTIF
  SUSPENDU
  RADIE

  @@map("statut_membre")
}

enum LienParenteEnum {
  PERE     @map("Père")
  MERE     @map("Mère")
  CONJOINT @map("Conjoint")
  ENFANT   @map("Enfant")

  @@map("lien_parente_enum")
}

enum StatutCotisation {
  EN_ATTENTE
  PAYEE
  EN_RETARD
  ANNULEE

  @@map("statut_cotisation")
}

enum ModePaiementEnum {
  ESPECES
  MOBILE_MONEY
  VIREMENT
  CHEQUE
  CARTE

  @@map("mode_paiement_enum")
}

enum TypePrestationEnum {
  NAISSANCE
  MARIAGE_MEMBRE
  DECES_PERE
  DECES_MERE
  DECES_CONJOINT
  DECES_ENFANT
  DEPART_RETRAITE
  MUTATION

  @@map("type_prestation_enum")
}

enum StatutPrestation {
  EN_ATTENTE
  VALIDEE
  REJETEE
  PAYEE

  @@map("statut_prestation")
}

enum PlanAbonnement {
  ESSAI
  ESSENTIEL
  PRO
  PREMIUM

  @@map("plan_abonnement")
}

enum StatutAbonnement {
  ACTIF
  SUSPENDU
  EXPIRE

  @@map("statut_abonnement")
}

enum PlanType {
  GRATUIT
  PREMIUM
  ENTERPRISE
}

enum ModePaiement {
  CINETPAY
  CASH
  VIREMENT
  CHEQUE
  GRATUIT
}

enum TypeTransaction {
  ABONNEMENT
  DON
}

enum StatutPaiement {
  EN_ATTENTE
  SUCCES
  ECHOUE
  ANNULE
}

enum PeriodeAbonnement {
  MENSUEL
  ANNUEL
}
